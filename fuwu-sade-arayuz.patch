+
+/* ===== Giriş ekranı: tek akış, tek ana düğme (Getir / Trendyol / Airbnb düzeni) ===== */
+.login-column { max-width: 440px; width: 100%; margin-inline: auto; }
+.premium-login-intro h1 { font-size: clamp(26px, 6vw, 32px); }
+.login-card { display: grid; gap: 14px; padding: 22px; border: 1px solid var(--border); border-radius: 20px; background: #fff; box-shadow: 0 20px 40px -28px rgba(10,37,64,.35); }
+.login-status { padding: 11px 14px; border-radius: 12px; font-size: 14px; font-weight: 600; line-height: 1.5; }
+.login-status.is-success { background: var(--trust-green-soft); color: var(--trust-green); }
+.login-status.is-error { background: #fdecec; color: #b42318; }
+.login-status.is-info { background: var(--surface-soft); color: var(--brand-navy); }
+.login-google { display: flex; align-items: center; justify-content: center; gap: 12px; min-height: 52px; border: 1px solid #d5d9e0; border-radius: 14px; background: #fff; color: var(--brand-navy); font-size: 16px; font-weight: 600; transition: background-color .15s, border-color .15s; }
+.login-google:hover { background: #f8f9fb; border-color: #b9c0cb; }
+.login-google:disabled { opacity: .6; cursor: progress; }
+.login-divider { display: flex; align-items: center; gap: 12px; color: var(--muted); font-size: 13px; }
+.login-divider::before, .login-divider::after { content: ""; flex: 1; height: 1px; background: var(--border); }
+.login-tabs { display: grid; grid-template-columns: 1fr 1fr; gap: 4px; padding: 4px; border-radius: 14px; background: var(--surface-soft); }
+.login-tab { display: inline-flex; align-items: center; justify-content: center; gap: 8px; min-height: 44px; border-radius: 10px; color: var(--muted); font-size: 15px; font-weight: 600; }
+.login-tab[aria-selected=true] { background: #fff; color: var(--brand-navy); box-shadow: 0 1px 3px rgba(10,37,64,.12); }
+.login-form { display: grid; gap: 10px; }
+.login-label { color: var(--brand-navy); font-size: 14px; font-weight: 600; }
+.login-input { width: 100%; min-height: 52px; padding: 0 16px; border: 1px solid #d5d9e0; border-radius: 14px; background: #fff; color: var(--brand-navy); font-size: 16px; outline: none; transition: border-color .15s, box-shadow .15s; }
+.login-input:focus { border-color: var(--brand-orange); box-shadow: 0 0 0 4px var(--brand-orange-soft); }
+.login-input::placeholder { color: #9aa3b2; }
+.login-submit { display: inline-flex; align-items: center; justify-content: center; gap: 8px; min-height: 52px; border-radius: 14px; background: var(--brand-orange); color: #241c16; font-size: 16px; font-weight: 700; transition: filter .15s; }
+.login-submit:hover { filter: brightness(.96); }
+.login-submit:disabled { opacity: .65; cursor: progress; }
+.login-hint { color: var(--muted); font-size: 13px; line-height: 1.5; }
+.login-otp-actions { display: flex; justify-content: space-between; gap: 12px; flex-wrap: wrap; }
+.login-otp-actions button { min-height: 44px; color: var(--brand-orange-dark); font-size: 14px; font-weight: 600; text-decoration: underline; text-underline-offset: 4px; }
+.login-otp-actions button:disabled { color: var(--muted); text-decoration: none; }
+.login-legal { color: var(--muted); font-size: 12.5px; line-height: 1.6; text-align: center; }
+.login-legal a { color: var(--brand-navy); text-decoration: underline; text-underline-offset: 3px; }
+.login-after { display: flex; justify-content: space-between; align-items: center; gap: 12px; margin-top: 16px; font-size: 14px; font-weight: 600; }
+.login-after a { display: inline-flex; align-items: center; min-height: 44px; color: var(--brand-navy); }
+.login-after a:last-child { color: var(--muted); text-decoration: underline; text-underline-offset: 3px; }
+@media (max-width: 639px) { .login-card { padding: 18px; border-radius: 18px; } }
+
+/* ===== Sadeleştirme katmanı (mobil uygulama düzeni) ===== */
+/* Kategori çipleri tek satırda yatay kayar; 5 satıra taşan yığın yok. */
+.catalog-category-nav { flex-wrap: nowrap; overflow-x: auto; scroll-snap-type: x proximity; scrollbar-width: none; padding: 2px 0 6px; -webkit-overflow-scrolling: touch; }
+.catalog-category-nav::-webkit-scrollbar { display: none; }
+.catalog-category-nav a { flex: 0 0 auto; scroll-snap-align: start; white-space: nowrap; }
+@media (min-width: 1024px) { .catalog-category-nav { flex-wrap: wrap; overflow: visible; margin-inline: 0; padding: 0; } }
+
+@media (max-width: 639px) {
+  /* Usta bul: ekmek kırıntısı ve tekrar eden düğme mobilde gereksiz yer kaplıyor. */
+  .market-breadcrumb, .market-directory-header .market-outline-link { display: none; }
+  /* Hizmet ve ilçe yan yana; arama ve "Ustaları Göster" tam genişlik. */
+  .market-filter-grid { grid-template-columns: repeat(2, minmax(0, 1fr)) !important; gap: 10px; }
+  .market-filter-grid > label:first-child { grid-column: 1 / -1 !important; grid-row: 1 !important; }
+  .market-filter-grid > label:nth-child(2) { grid-column: 1 !important; grid-row: 2 !important; }
+  .market-filter-grid > label:nth-child(3) { grid-column: 2 !important; grid-row: 2 !important; }
+  .market-filter-grid select { min-width: 0; padding-left: 12px !important; padding-right: 30px !important; font-size: 16px !important; font-weight: 600 !important; text-overflow: ellipsis; }
+  .market-filter-grid > .market-filter-submit, .market-filter-grid > button:last-child { grid-column: 1 / -1 !important; grid-row: 3 !important; }
+  /* Usta ol: büyük fotoğraf mobilde formu ekranın altına itiyordu. */
+  .market-join-photo { display: none; }
+  /* Güven maddeleri: altı kart alt alta yerine yatay kaydırılan kartlar. */
+  .trust-promise-grid { display: flex; overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; margin-inline: 0; padding: 2px 0 8px; gap: 12px; }
+  .trust-promise-grid::-webkit-scrollbar { display: none; }
+  .trust-promise-grid li { flex: 0 0 78%; scroll-snap-align: start; grid-template-columns: 44px 1fr; }
+}
+
+/* Bölüm başlığındaki "Tümü" bağlantıları iki satıra kırılmasın. */
+.home-section-heading .home-text-link { white-space: nowrap; flex-shrink: 0; }

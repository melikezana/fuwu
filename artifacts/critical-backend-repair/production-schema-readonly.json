  "functions": [
    {
      "name": "set_updated_at",
      "definition": "CREATE OR REPLACE FUNCTION public.set_updated_at()\n RETURNS trigger\n LANGUAGE plpgsql\nAS $function$\r\nbegin\r\n  new.updated_at = timezone('utc', now());\r\n  return new;\r\nend;\r\n$function$\n"
    },
    {
      "name": "enforce_payout_preconditions",
      "definition": "CREATE OR REPLACE FUNCTION public.enforce_payout_preconditions()\n RETURNS trigger\n LANGUAGE plpgsql\nAS $function$\r\ndeclare\r\n  v_status text;\r\n  v_open_dispute integer;\r\nbegin\r\n  select status into v_status\r\n  from public.orders\r\n  where id = new.order_id;\r\n\r\n  if v_status is null then\r\n    raise exception 'Payout icin order bulunamadi (order_id=%).', new.order_id;\r\n  end if;\r\n\r\n  if v_status <> 'APPROVED' then\r\n    raise exception 'Payout yalnizca APPROVED order icin olusturulabilir (mevcut durum=%).', v_status;\r\n  end if;\r\n\r\n  select count(*) into v_open_dispute\r\n  from public.disputes\r\n  where order_id = new.order_id\r\n    and status in ('OPEN', 'UNDER_REVIEW');\r\n\r\n  if v_open_dispute > 0 then\r\n    raise exception 'Acik dispute varken payout olusturulamaz (order_id=%).', new.order_id;\r\n  end if;\r\n\r\n  return new;\r\nend;\r\n$function$\n"
    },
    {
      "name": "set_service_request_assigned_at",
      "definition": "CREATE OR REPLACE FUNCTION public.set_service_request_assigned_at()\n RETURNS trigger\n LANGUAGE plpgsql\nAS $function$\r\nbegin\r\n  if new.assigned_provider_id is not null\r\n     and (tg_op = 'INSERT' or old.assigned_provider_id is null) then\r\n    new.assigned_at := timezone('utc', now());\r\n  end if;\r\n\r\n  if new.assigned_provider_id is null then\r\n    new.assigned_at := null;\r\n  end if;\r\n\r\n  return new;\r\nend;\r\n$function$\n"
    }
  ],
